module NATS
  class KeyValue
    KV_OP: 'KV-Operation'
    KV_DEL: 'DEL'
    KV_PURGE: 'PURGE'
    KV_PUT: 'PUT'

    module Operation
      PUT: 'PUT'
      DELETE: 'DEL'
      PURGE: 'PURGE'
    end

    ALL_KEYS: '>'
    KEY_VALUE_MAX_HISTORY: 64
    MSG_ROLLUP_SUBJECT: 'sub'
    MSG_ROLLUP_ALL: 'all'
    ROLLUP: 'Nats-Rollup'
    MARKER_REASON: 'Nats-Marker-Reason'

    VALID_BUCKET_RE: Regexp

    def self.validate_bucket_name: (String?) -> void

    def self.operation_of: (Hash[String, String]?) -> String?

    @name: String
    @stream: String
    @pre: String
    @put_pre: String
    @js: NATS::JetStream
    @direct: bool

    def initialize: (Hash[Symbol, untyped]) -> void

    def get: (String, ?Hash[Symbol, untyped]) -> NATS::KeyValue::Entry

    private def _get: (String, ?Hash[Symbol, untyped]) -> NATS::KeyValue::Entry

    def put: (String, untyped) -> Integer

    def create: (String, untyped, ?Hash[Symbol, untyped]) -> Integer

    EXPECTED_LAST_SUBJECT_SEQUENCE: 'Nats-Expected-Last-Subject-Sequence'

    WRONG_LAST_SEQUENCE_ERR_CODES: Array[Integer]

    def update: (String, untyped, ?Hash[Symbol, untyped]) -> Integer

    private def update_revision: (String, untyped, Integer, (Integer | :never)?) -> Integer

    def delete: (String, ?Hash[Symbol, untyped]) -> Integer

    def purge: (String, ?Hash[Symbol, untyped]) -> NATS::JetStream::PubAck

    PURGE_DELETES_MARKER_THRESHOLD: Integer

    def purge_deletes: (?Hash[Symbol, untyped]) -> nil

    def status: () -> NATS::KeyValue::BucketStatus

    def keys: (?(Hash[Symbol, untyped] | Array[String] | String)) ?{ (String) -> void } -> untyped

    def list_keys: (?Hash[Symbol, untyped]) -> NATS::KeyLister

    def list_keys_filtered: (*(String | Array[String]), **untyped) -> NATS::KeyLister

    class Entry < Struct[untyped]
    end
  end

  class KeyLister
    include Enumerable[String]

    @watcher: untyped
    @updates: Thread::SizedQueue
    @mon: Monitor
    @stopped: bool

    def initialize: (untyped) -> void

    def each: () { (String) -> void } -> self
            | () -> Enumerator[String, self]

    alias keys each

    def stop: () -> nil

    def stopped?: () -> bool
  end
end
