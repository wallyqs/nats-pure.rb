module NATS
  class KeyValue
    class Error < NATS::Error
    end

    class KeyNotFoundError < NATS::KeyValue::Error
      attr_reader entry: NATS::KeyValue::Entry
      attr_reader op: String

      @message: String

      def initialize: (Hash[Symbol, untyped]) -> void
    end

    class KeyDeletedError < NATS::KeyValue::KeyNotFoundError
    end

    class BucketNotFoundError < NATS::KeyValue::Error
    end

    class BadBucketError < NATS::KeyValue::Error
    end

    module KeyRevisionMismatch
    end

    class KeyWrongLastSequenceError < NATS::KeyValue::Error
      include NATS::KeyValue::KeyRevisionMismatch

      @msg: String

      def initialize: (String) -> void
    end

    class KeyExistsError < NATS::KeyValue::KeyWrongLastSequenceError
    end

    class KeyRevisionMismatchError < NATS::JetStream::Error::WrongLastSequence
      include NATS::KeyValue::KeyRevisionMismatch
    end

    class InvalidBucketNameError < ArgumentError
      def initialize: (?String) -> void
    end

    class BucketRequiredError < NATS::KeyValue::InvalidBucketNameError
    end

    class KeyValueConfigRequiredError < ArgumentError
      def initialize: (?String) -> void
    end

    class BucketExistsError < NATS::JetStream::Error::StreamNameAlreadyInUse
      attr_reader bucket: String?

      def initialize: (?Hash[Symbol, untyped]) -> void
    end

    class TTLOnDeleteNotSupportedError < NATS::KeyValue::Error
    end

    class LimitMarkerTTLNotSupportedError < NATS::KeyValue::Error
    end
  end
end
