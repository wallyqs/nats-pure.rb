module NATS
  # class << self
  def self.connect: (String?, Hash[Symbol, untyped]) -> NATS::Client

  def self.new_inbox: (?String) -> String

  private

  def self.check_inbox_prefix!: (String?) -> void
  # end class << self

  INBOX_NUID_LOCK: Thread::Mutex

  module Status
    DISCONNECTED: Integer
    CONNECTED: Integer
    CLOSED: Integer
    RECONNECTING: Integer
    CONNECTING: Integer
    DRAINING_SUBS: Integer
    DRAINING_PUBS: Integer
  end

  class Client
    include MonitorMixin
    include Status

    attr_reader status: Integer
    attr_reader server_info: Hash[Symbol, untyped]
    attr_reader server_pool: Array[untyped]
    attr_reader options: Hash[Symbol, untyped]?
    attr_reader connected_server: String?
    attr_reader stats: Hash[Symbol, Integer]
    attr_reader uri: String?
    attr_reader subscription_executor: Concurrent::ThreadPoolExecutor?
    attr_reader reloader: Proc

    DEFAULT_PORT: Hash[Symbol, Integer]
    DEFAULT_URI: String

    CR_LF: '\r\n'
    CR_LF_SIZE: Integer

    PING_REQUEST: String
    PONG_RESPONSE: String

    NATS_HDR_VERSION: String
    NATS_HDR_LINE: String
    STATUS_MSG_LEN: 3
    STATUS_HDR: 'Status'
    DESC_HDR: 'Description'
    NATS_HDR_LINE_SIZE: Integer

    SUB_OP: 'SUB'
    EMPTY_MSG: ''

    REDACTED: String

    SERVER_ERRORS: Hash[String, singleton(NATS::IO::Error)]

    INSTANCES: ObjectSpace::WeakMap

    @options: Hash[Symbol, untyped]

    @io: NATS::IO::Socket?

    @flush_queue: Thread::SizedQueue?
    @pending_queue: Thread::SizedQueue?

    @parser: NATS::Protocol::Parser

    @flusher_thread: Thread?
    @read_loop_thread: Thread?
    @ping_interval_thread: Thread?
    @subscription_executor: Concurrent::ThreadPoolExecutor?

    @subs: Hash[Symbol, untyped]
    @ssid: Integer

    @pings_outstanding: Integer
    @pongs_received: Integer
    @pongs: Array[MonitorMixin::ConditionVariable]

    @pending_size: Integer
    @flush_lock: Thread::Mutex

    @last_err: untyped

    @err_cb: Proc
    @close_cp: Proc
    @disconnect_cb: Proc
    @reconnect_cb: Proc
    @connect_cb: Proc?
    @discovered_servers_cb: Proc?
    @lame_duck_mode_cb: Proc?
    @reconnect_error_cb: Proc?

    @tls: bool?

    @hostname: String?
    @single_url_connect_used: bool

    @connect_called: bool
    @connect_retrying: bool

    @resp_sub: NATS::Subscription?
    @resp_map: Hash[String | Symbol, untyped]?
    @resp_sub_prefix: String?
    @nuid: NATS::NUID

    @user_credentials: String?
    @nkeys_seed: String?
    @user_nkey_cb: Proc?
    @user_jwt_cb: Proc?
    @signature_cb: Proc?

    @user_credentials_data: String?
    @user_jwt: String?
    @user_seed: String?

    @auth_token: String?
    @token_handler: Proc?
    @user_info_handler: Proc?

    @inbox_prefix: String

    @drain_t: Thread?

    @status_listeners: Array[Proc]

    @reloader: Proc

    def self.default_reloader: -> Proc

    def connect: ((String | Hash[Symbol, untyped])?, Hash[Symbol, untyped]) -> self

    def publish: (String, String, String?, **Hash[Symbol, untyped]) -> void

    def publish_msg: (NATS::Msg) -> void

    def subscribe: (String, Hash[Symbol, untyped]) ?{ (?(NATS::Msg | String), ?String, ?String, ?Hash[Symbol, untyped]) -> void } -> NATS::Subscription

    def request: (String, ?String, **Hash[Symbol, untyped]) ?{ (?(NATS::Msg | String), ?String, ?String, ?Hash[Symbol, untyped]) -> void } -> NATS::Msg

    def request_msg: (NATS::Msg, **Hash[Symbol, untyped]) -> NATS::Msg

    def old_request: (String, ?String, **Hash[Symbol, untyped]) ?{ (?(NATS::Msg | String), ?String, ?String, ?Hash[Symbol, untyped]) -> void } -> NATS::Msg

    def flush: (?Integer) -> void

    def rtt: () -> Float

    def barrier: () { () -> void } -> void

    alias servers server_pool

    def discovered_servers: () -> Array[String]

    def set_server_pool: (Array[String | URI::Generic]) -> nil

    def close: () -> void

    def new_inbox: () -> String

    def connected_url_redacted: () -> String?

    def connected_addr: () -> String?

    def local_addr: () -> String?

    def num_subscriptions: () -> Integer

    def buffered: () -> Integer

    def connected_server_id: () -> String?

    def connected_server_name: () -> String?

    def connected_server_version: () -> String?

    def connected_cluster_name: () -> String?

    def client_id: () -> Integer?

    def client_ip: () -> String?

    def max_payload: () -> Integer?

    def headers_supported?: () -> bool

    def auth_required?: () -> bool

    def tls_required?: () -> bool

    def tls_connection_state: () -> NATS::IO::TLSConnectionState

    def jetstream?: () -> bool

    def error_handler: () -> Proc?

    def disconnect_handler: () -> Proc?

    def reconnect_handler: () -> Proc?

    def close_handler: () -> Proc?

    def connect_handler: () -> Proc?

    def discovered_servers_handler: () -> Proc?

    def lame_duck_mode_handler: () -> Proc?

    def reconnect_error_handler: () -> Proc?

    def connected?: () -> bool

    def connecting?: () -> bool

    def reconnecting?: () -> bool

    def closed?: () -> bool

    def draining?: () -> bool

    def on_error: () { (?self, ?untyped, ?NATS::Subscription) -> void } -> void

    def on_disconnect: () { (?untyped) -> void } -> void

    def on_reconnect: () { () -> void } -> void

    def on_close: () { () -> void } -> void

    def on_connect: () { () -> void } -> void

    def on_discovered_servers: () { () -> void } -> void

    def on_lame_duck_mode: () { () -> void } -> void

    def on_reconnect_error: () { (untyped) -> void } -> void

    def last_error: () -> untyped

    def drain: () -> void

    def jetstream: (**Hash[Symbol, untyped]) -> NATS::JetStream
    alias JetStream jetstream
    alias jsm jetstream

    private

    def connected_server_info: (Symbol) -> untyped

    def server_info_unless_closed: (Symbol) -> untyped

    def socket_address: (Symbol) -> String?

    def validate_auth_options!: () -> void

    def validate_settings!: () -> void

    def process_info: (String) -> Hash[Symbol, untyped]

    def process_hdr: (String) -> Hash[String, untyped]?

    def process_pong: () -> void

    def process_ping: () -> void

    def process_err: (String) -> void

    def server_error_for: (String, bool?) -> NATS::IO::Error

    def current_server: () -> Hash[Symbol, untyped]?

    def auth_error_abort?: (Hash[Symbol, untyped]?, Exception?) -> bool

    def process_msg: (String, String, String, String, String) -> void

    def subscribed?: (NATS::Subscription) -> bool

    def received_msg: (String, String?, String, String?, Hash[String, untyped]?, NATS::Subscription) -> NATS::Msg

    def select_next_error: () -> untyped

    def server_using_secure_connection?: () -> bool

    def client_using_secure_connection?: () -> bool

    def tls_context: () -> OpenSSL::SSL::SSLContext?

    def new_tls_context: () -> OpenSSL::SSL::SSLContext

    def single_url_connect_used?: () -> bool

    def check_max_payload!: (Integer) -> void

    def check_reconnect_buf!: () -> void

    def send_command: (String) -> void

    def unsubscribe: (NATS::Subscription, Integer?) -> void

    def drain_sub: (NATS::Subscription) -> void

    def drain_subscription: (NATS::Subscription) -> nil

    def finish_sub_drain: (NATS::Subscription) -> void

    def do_drain: () -> void

    def send_flush_queue: (Symbol) -> void

    def delete_sid: (Symbol) -> void

    def add_status_listener: () { (Symbol) -> void } -> Proc

    def remove_status_listener: (Proc) -> Proc?

    def notify_status_listeners: (Symbol) -> void

    def async_cb_call: (Proc?) -> void

    def reconnect_error_cb_call: (untyped) -> void

    def err_cb_call: (self, untyped, NATS::Subscription) -> void

    def auth_connection?: () -> bool

    def connect_command: () -> String

    def process_op_error: (untyped) -> void

    def read_loop: () -> void

    def flusher_loop: () -> void

    def force_flush!: () -> void

    def flush_pending!: () -> void

    def write_pending: () -> void

    def handle_flush_error: (untyped) -> void

    def ping_interval_loop: () -> void

    def process_connect_init: () -> void

    def retry_connect_in_background: () -> Thread

    def attempt_reconnect: (Integer, ?initial: bool) -> void

    def close_with_callbacks: () -> void

    def close_connection: (Integer, ?bool, ?user_cbs: bool) -> void

    def start_threads!: () -> void

    def start_resp_mux_sub!: () -> void

    def can_reuse_server?: (Hash[Symbol, untyped]) -> bool

    def reconnect_delay: (Hash[Symbol, untyped]?) -> Float

    def parse_server_urls: (String | URI::Generic) -> Array[URI::Generic]

    def same_server?: (URI::Generic, URI::Generic) -> bool

    def should_delay_connect?: () -> bool

    def should_not_reconnect?: () -> bool

    def should_reconnect?: () -> bool

    def create_socket: () -> NATS::IO::Socket

    def setup_nkeys_connect: () -> void

    def signature_cb_for_nkey_file: (String) -> Proc

    def nkey_cb_for_nkey_file: (String) -> Proc

    def jwt_cb_for_creds_file: (String) -> Proc

    def signature_cb_for_creds_file: (String) -> Proc

    def creds_section: (Array[String], String) -> String?

    def signature_cb_for_seed: (String) -> Proc

    def process_uri: (String) -> Array[URI::Generic]
  end

  module IO
    include Status

    Client: NATS::Client

    MAX_RECONNECT_ATTEMPTS: 10
    RECONNECT_TIME_WAIT: 2
    RECONNECT_JITTER: Float
    RECONNECT_JITTER_TLS: Integer

    MAX_PENDING_SIZE: 32768

    MAX_FLUSH_KICK_SIZE: 1024

    MAX_SOCKET_READ_BYTES: 32768

    DEFAULT_PING_INTERVAL: 120
    DEFAULT_PING_MAX: 2

    DEFAULT_RECONNECT_BUF_SIZE: Integer

    DEFAULT_CONNECT_TIMEOUT: 2
    DEFAULT_READ_WRITE_TIMEOUT: 2
    DEFAULT_DRAIN_TIMEOUT: 30

    DEFAULT_INBOX_PREFIX: String

    DEFAULT_SUB_PENDING_MSGS_LIMIT: 65536
    DEFAULT_SUB_PENDING_BYTES_LIMIT: Integer

    class TLSConnectionState < Struct[String | Array[OpenSSL::X509::Certificate] | bool | nil]
      attr_accessor version: String
      attr_accessor cipher: String?
      attr_accessor peer_certificates: Array[OpenSSL::X509::Certificate]
      attr_accessor server_name: String?
      attr_accessor negotiated_protocol: String?
      attr_accessor did_resume: bool
      attr_accessor handshake_complete: bool

      def self.of: (OpenSSL::SSL::SSLSocket) -> NATS::IO::TLSConnectionState
    end

    class Socket
      attr_accessor socket: ::Socket?

      @uri: URI::Generic
      @connect_timeout: Numeric
      @write_timeout: Numeric
      @read_timeout: Numeric
      @tls: Hash[Symbol, untyped]?
      @dialer: untyped
      @skip_host_lookup: bool?

      def connect: () -> void

      def read_line: (Numeric?) -> untyped

      def read: (Integer, Numeric?) -> untyped

      def write: (String, Numeric?) -> void

      def close: () -> void

      def closed?: () -> bool

      def tls_socket: () -> OpenSSL::SSL::SSLSocket?

      def remote_address: () -> String

      def local_address: () -> String

      private

      def time_left: (Float?) -> Float?

      def raw_socket: () -> ::Socket

      def tls_handshake: (OpenSSL::SSL::SSLSocket) -> void

      def connect_addrinfo: (String | Integer, Integer, Numeric) -> ::Socket

      def skip_tls_handshake?: () -> bool

      def dial_host: () -> void

      def dial_custom: () -> void
    end
  end

  NANOSECONDS: 1_000_000_000

  class MonotonicTime
    # class << self
    def self.now: () -> Float

    def self.with_nats_timeout: (Float) -> Float

    def self.since: (Float) -> Float
    # end class << self
  end
end
