module NATS
  class JetStream
    module JS
      DefaultAPIPrefix: '$JS.API'

      STATUS_ERRORS: Hash[Integer, singleton(NATS::JetStream::Error::APIError)]

      ERR_CODE_ERRORS: Hash[Integer, singleton(NATS::JetStream::Error::APIError)]

      CONFLICT_ERRORS: Hash[String, singleton(NATS::JetStream::Error::APIError)]

      # class << self
      def self.next_req_to_json: (Hash[Symbol, untyped]) -> String

      def self.nanoseconds: (Numeric, String) -> Integer

      def self.seconds: (Integer?) -> (Integer | Float)?

      def self.parse_time: (String | Time | nil) -> Time?

      def self.is_status_msg: (NATS::Msg) -> bool

      def self.check_503_error: (NATS::Msg) -> void

      def self.from_msg: (NATS::Msg) -> (NATS::JetStream::API::Error | NATS::JetStream::Error::PinIdMismatch | NATS::JetStream::Error::MaxBytesExceeded | NATS::JetStream::Error::ConsumerDeleted)

      def self.max_bytes_exceeded?: (NATS::Msg) -> bool

      def self.msg_size: (NATS::Msg) -> Integer

      def self.from_error: (Hash[Symbol, untyped]) -> NATS::JetStream::API::Error
      # end class << self
    end
  end
end