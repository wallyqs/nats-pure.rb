module NATS
  class JetStream
    module Manager
      def add_stream: (JetStream::API::StreamConfig, ?Hash[Symbol, untyped]) -> JetStream::API::StreamCreateResponse

      def stream_info: (String, ?Hash[Symbol, untyped]) -> JetStream::API::StreamInfo

      def update_stream: (JetStream::API::StreamConfig, ?Hash[Symbol, untyped]) -> JetStream::API::StreamCreateResponse

      def create_or_update_stream: (JetStream::API::StreamConfig | Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> JetStream::API::StreamCreateResponse

      def delete_stream: (String, ?Hash[Symbol, untyped]) -> bool

      def purge_stream: (String, ?Hash[Symbol, untyped]) -> JetStream::API::StreamPurgeResponse

      def delete_msg: (String, Integer, ?Hash[Symbol, untyped]) -> bool

      def secure_delete_msg: (String, Integer, ?Hash[Symbol, untyped]) -> bool

      def stream_names: (?Hash[Symbol, untyped]) -> Array[String]

      def streams: (?Hash[Symbol, untyped]) -> Array[JetStream::API::StreamInfo]

      def consumer_names: (String, ?Hash[Symbol, untyped]) -> Array[String]

      def consumers: (String, ?Hash[Symbol, untyped]) -> Array[JetStream::API::ConsumerInfo]

      def add_consumer: (String, JetStream::API::ConsumerConfig | Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> JetStream::API::ConsumerInfo

      def create_consumer: (String, JetStream::API::ConsumerConfig | Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> JetStream::API::ConsumerInfo

      def update_consumer: (String, JetStream::API::ConsumerConfig | Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> JetStream::API::ConsumerInfo

      def consumer_info: (String, String, ?Hash[Symbol, untyped]) -> JetStream::API::ConsumerInfo

      def delete_consumer: (String, String, ?Hash[Symbol, untyped]) -> bool

      def pause_consumer: (String, String, Time | String, ?Hash[Symbol, untyped]) -> JetStream::API::ConsumerPauseResponse

      def resume_consumer: (String, String, ?Hash[Symbol, untyped]) -> JetStream::API::ConsumerPauseResponse

      def unpin_consumer: (String, String, String, ?Hash[Symbol, untyped]) -> bool

      def reset_consumer: (String, String, ?Hash[Symbol, untyped]) -> JetStream::API::ConsumerResetResponse

      def find_stream_name_by_subject: (String, ?Hash[Symbol, untyped]) -> String

      def get_msg: (String, ?Hash[Symbol, untyped]) -> JetStream::API::RawStreamMsg

      def get_last_msg: (String, String, ?Hash[Symbol, untyped]) -> JetStream::API::RawStreamMsg

      def account_info: (?Hash[Symbol, untyped]) -> JetStream::API::AccountInfo

      private

      def upsert_consumer: (String, JetStream::API::ConsumerConfig | Hash[Symbol, untyped], String?, Hash[Symbol, untyped]) -> JetStream::API::ConsumerInfo

      def paged_request: (String, Symbol, Hash[Symbol, untyped], Hash[Symbol, untyped]) -> Array[untyped]

      def check_stream_applied: (JetStream::API::StreamConfig, Hash[Symbol, untyped]) -> void

      def request_pause: (String, String, Hash[Symbol, String], Hash[Symbol, untyped]) -> JetStream::API::ConsumerPauseResponse

      def request_msg_delete: (String, Hash[Symbol, untyped], Hash[Symbol, untyped]) -> bool

      def rfc3339: (Time | String | nil) -> String?

      def api_request: (String, String, ?Hash[Symbol, untyped]) -> Hash[Symbol, untyped]

      def parse_response: (NATS::Msg) -> Hash[Symbol, untyped]

      def _lift_msg_to_raw_msg: (NATS::Msg) -> JetStream::API::RawStreamMsg

      def stream_config_json: (JetStream::API::StreamConfig) -> String
    end
  end
end