module NATS
  class JetStream
    module ErrorCode
      BAD_REQUEST: 10003

      JETSTREAM_NOT_AVAILABLE: 10008

      CONSUMER_CREATE: 10012

      CONSUMER_NAME_EXISTS: 10013

      CONSUMER_NOT_FOUND: 10014

      INSUFFICIENT_RESOURCES: 10023

      MAXIMUM_CONSUMERS_LIMIT: 10026

      MESSAGE_NOT_FOUND: 10037

      JETSTREAM_NOT_ENABLED_FOR_ACCOUNT: 10039

      STREAM_NAME_IN_USE: 10058

      STREAM_NOT_FOUND: 10059

      STREAM_WRONG_LAST_SEQUENCE: 10071

      JETSTREAM_NOT_ENABLED: 10076

      CONSUMER_ALREADY_EXISTS: 10105

      DUPLICATE_FILTER_SUBJECTS: 10136

      OVERLAPPING_FILTER_SUBJECTS: 10138

      CONSUMER_EMPTY_FILTER: 10139

      CONSUMER_EXISTS: 10148

      CONSUMER_DOES_NOT_EXIST: 10149

      STREAM_WRONG_LAST_SEQUENCE_CONSTANT: 10164

      MIRROR_WITH_MSG_SCHEDULES: 10186

      SOURCE_WITH_MSG_SCHEDULES: 10187

      MESSAGE_SCHEDULES_DISABLED: 10188

      SCHEDULE_PATTERN_INVALID: 10189

      SCHEDULE_TARGET_INVALID: 10190

      SCHEDULE_TTL_INVALID: 10191

      SCHEDULE_ROLLUP_INVALID: 10192

      SCHEDULE_SOURCE_INVALID: 10203

      CONSUMER_INVALID_RESET: 10204
    end

    class Error < NATS::IO::Error
      class NoStreamResponse < NATS::JetStream::Error
      end

      class InvalidDurableName < NATS::JetStream::Error
      end

      class InvalidJSAck < NATS::JetStream::Error
      end

      class MsgAlreadyAckd < NATS::JetStream::Error
      end

      class NotJSMessage < NATS::JetStream::Error
      end

      class InvalidStreamName < NATS::JetStream::Error
      end

      class InvalidConsumerName < NATS::JetStream::Error
      end

      class MsgDeleteUnsuccessful < NATS::JetStream::Error
      end

      class NotPullConsumer < NATS::JetStream::Error
      end

      class NotPushConsumer < NATS::JetStream::Error
      end

      class MsgNotBound < NATS::JetStream::Error
      end

      class MsgNoReply < NATS::JetStream::Error
      end

      class InvalidJetStreamResponse < NATS::JetStream::Error
      end

      class TooManyStalledMsgs < NATS::JetStream::Error
      end

      class AsyncPublishTimeout < NATS::JetStream::Error
      end

      class PublisherClosed < NATS::JetStream::Error
      end

      class AsyncPublishReplySubjectSet < NATS::JetStream::Error
      end

      class NoHeartbeat < NATS::JetStream::Error
      end

      class StreamSubjectTransformNotSupported < NATS::JetStream::Error
      end

      class StreamSourceSubjectTransformNotSupported < NATS::JetStream::Error::StreamSubjectTransformNotSupported
      end

      class StreamSourceNotSupported < NATS::JetStream::Error
      end

      class ConsumerMultipleFilterSubjectsNotSupported < NATS::JetStream::Error
      end

      class ConsumerCreationResponseEmpty < NATS::JetStream::Error
        def initialize: (?String) -> void
      end

      class ConsumerResetResponseEmpty < NATS::JetStream::Error
        def initialize: (?String) -> void
      end

      class ConsumerNotActive < NATS::JetStream::Error
      end

      class ConsumerSequenceMismatch < NATS::JetStream::Error
        attr_reader stream_resume_sequence: Integer
        attr_reader consumer_sequence: Integer
        attr_reader last_consumer_sequence: Integer

        def initialize: (?stream_resume_sequence: Integer, ?consumer_sequence: Integer, ?last_consumer_sequence: Integer) -> void
      end

      class MsgIteratorClosed < NATS::JetStream::Error
      end

      class ConsumerAlreadyConsuming < NATS::JetStream::Error
      end

      class HandlerRequired < ::ArgumentError
        def initialize: (?String) -> void
      end

      class OrderedConsumerUsedAsFetch < NATS::JetStream::Error
      end

      class OrderedConsumerUsedAsConsume < NATS::JetStream::Error
      end

      class OrderedConsumerConcurrentRequests < NATS::JetStream::Error
      end

      class OrderedConsumerNotCreated < NATS::JetStream::Error
      end

      class APIError < NATS::JetStream::Error
        attr_reader code: Integer
        attr_reader err_code: Integer
        attr_reader description: String
        attr_reader stream: String
        attr_reader seq: Integer

        def initialize: (Hash[Symbol, untyped]) -> void
      end

      class ServiceUnavailable < NATS::JetStream::Error::APIError
      end

      class ServerError < NATS::JetStream::Error::APIError
      end

      class NotFound < NATS::JetStream::Error::APIError
      end

      class MsgNotFound < NATS::JetStream::Error::NotFound
      end

      class InvalidSubject < NATS::JetStream::Error::NotFound
        def initialize: (?String?) -> void

        def to_s: () -> String
      end

      class StreamNotFound < NATS::JetStream::Error::NotFound
      end

      class ConsumerNotFound < NATS::JetStream::Error::NotFound
      end

      class BadRequest < NATS::JetStream::Error::APIError
      end

      class JSBadRequest < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10003
      end

      class StreamNameAlreadyInUse < NATS::JetStream::Error::BadRequest
      end

      class ConsumerNameAlreadyInUse < NATS::JetStream::Error::BadRequest
      end

      class MaximumConsumersLimit < NATS::JetStream::Error::BadRequest
      end

      class DuplicateFilterSubjects < NATS::JetStream::Error::BadRequest
      end

      class OverlappingFilterSubjects < NATS::JetStream::Error::BadRequest
      end

      class EmptyFilter < NATS::JetStream::Error::BadRequest
      end

      class WrongLastSequence < NATS::JetStream::Error::BadRequest
      end

      class MessageSchedulesDisabled < NATS::JetStream::Error::BadRequest
      end

      class SchedulePatternInvalid < NATS::JetStream::Error::BadRequest
      end

      class ScheduleTargetInvalid < NATS::JetStream::Error::BadRequest
      end

      class ScheduleTTLInvalid < NATS::JetStream::Error::BadRequest
      end

      class ScheduleRollupInvalid < NATS::JetStream::Error::BadRequest
      end

      class ScheduleSourceInvalid < NATS::JetStream::Error::BadRequest
      end

      class MirrorWithMsgSchedules < NATS::JetStream::Error::BadRequest
      end

      class SourceWithMsgSchedules < NATS::JetStream::Error::BadRequest
      end

      class ConsumerAlreadyExists < NATS::JetStream::Error::BadRequest
      end

      class ConsumerExistingActive < NATS::JetStream::Error::BadRequest
      end

      class ConsumerDoesNotExist < NATS::JetStream::Error::BadRequest
      end

      class ConsumerInvalidReset < NATS::JetStream::Error::BadRequest
      end

      class ConsumerCreate < NATS::JetStream::Error::ServerError
      end

      class JetStreamNotEnabled < NATS::JetStream::Error::ServiceUnavailable
      end

      class JetStreamNotEnabledForAccount < NATS::JetStream::Error::ServiceUnavailable
      end

      class ConsumerDeleted < NATS::JetStream::Error::APIError
      end

      class ConsumerLeadershipChanged < NATS::JetStream::Error::APIError
      end

      class ServerShutdown < NATS::JetStream::Error::APIError
      end

      class NoMessages < NATS::JetStream::Error
        def initialize: (?String msg) -> void
      end

      class BatchUnsupported < NATS::JetStream::Error
        def initialize: (?String msg) -> void
      end

      class InvalidStreamResponse < NATS::JetStream::Error
        def initialize: (?String msg) -> void
      end

      class BatchClosed < NATS::JetStream::Error
        def initialize: (?String msg) -> void
      end

      class EmptyBatch < NATS::JetStream::Error
        def initialize: (?String msg) -> void
      end

      class InvalidBatchAck < NATS::JetStream::Error
        def initialize: (?String msg) -> void
      end

      class BatchPublishNotEnabled < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10174
      end

      class BatchPublishMissingSeq < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10175
      end

      class BatchPublishIncomplete < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10176
      end

      class BatchPublishUnsupportedHeader < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10177
      end

      class BatchPublishInvalidID < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10179
      end

      class MirrorWithAtomicPublish < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10198
      end

      class BatchPublishExceedsLimit < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10199
      end

      class BatchPublishInvalidCommit < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10200
      end

      class BatchPublishDuplicateMsgID < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10201
      end

      class AtomicPublishTooManyInflight < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10210
      end

      class FastBatchNotEnabled < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10205
      end

      class FastBatchInvalidPattern < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10206
      end

      class FastBatchInvalidID < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10207
      end

      class FastBatchUnknownID < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10208
      end

      class MirrorWithBatchPublish < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10209
      end

      class BatchPublishTooManyInflight < NATS::JetStream::Error::BadRequest
        ERR_CODE: 10211
      end

      class FastBatchGapDetected < NATS::JetStream::Error
        attr_reader expected_last_seq: Integer?
        attr_reader current_seq: Integer?

        def initialize: (?Integer? expected_last_seq, ?Integer? current_seq) -> void
      end

      BATCH_PUBLISH_ERRORS: Hash[Integer, singleton(NATS::JetStream::Error::BadRequest)]

      class PinIdMismatch < NATS::JetStream::Error::APIError
      end

      class MaxBytesExceeded < NATS::JetStream::Error::APIError
      end
    end
  end
end